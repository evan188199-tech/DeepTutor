  "findings": [
    {
      "id": "F-M1",
      "entry": "E06",
      "severity": "low",
      "category": "type_missing",
      "title": "Web MasteryEvent mirror omits backend path_id field",
      "frontend": "web/lib/learning-api.ts:206-216",
      "backend": "deeptutor/learning/models.py:335-345 (path_id at :337; arrives on the wire via model_dump mastery_path.py:845,897)",
      "impact": "The comment at learning-api.ts:204 claims a mirror of models.py, but path_id is missing from the interface. Harmless today (TS structural typing drops extras; backend model has extra=\"ignore\"), but the mirror claim is inaccurate and a consumer reading event.path_id gets a type error despite the field existing at runtime.",
      "suggestion": "add path_id: string to the web interface (doc-only change, no behavior)"
    },
    {
      "id": "F-B1",
      "entry": "E10",
      "severity": "low",
      "category": "field_drift",
      "title": "book-ws-operation errorMessage tolerates message/detail fields the backend never sends",
      "frontend": "web/lib/book-ws-operation.ts:34-39",
      "backend": "deeptutor/api/routers/book.py:1780-1807 (wire error events carry content, optionally status/code/current_revision; the HTTP detail dict is flattened at :1790-1803, message/detail never appear as wire fields)",
      "impact": "No functional bug today (content is always present), but the fallbacks suggest a passthrough contract that does not exist; a future reader may emit detail and silently rely on a path that nothing sends.",
      "suggestion": "either drop the message/detail fallbacks or document them as client-side tolerance for non-DeepTutor sockets"
    },
    {
      "id": "F-B2",
      "entry": "E13",
      "severity": "info",
      "category": "asymmetry",
      "title": "confirm_spine WS action has no web consumer",
      "frontend": "web/lib/book-api.ts:183-203 (confirmSpine uses REST POST /books/confirm-spine)",
      "backend": "deeptutor/api/routers/book.py:1692-1718 (WS branch emits confirm_spine_result)",
      "impact": "Backend-only result type; nothing on the web parses confirm_spine_result. Not a bug — a parallel surface kept in sync manually.",
      "suggestion": "leave as is, or note the dead WS action in the endpoint docstring"
    },
    {
      "id": "F-B3",
      "entry": "E16",
      "severity": "info",
      "category": "type_missing",
      "title": "BookWsEvent leaves the serialized envelope untyped",
      "frontend": "web/lib/book-ws-operation.ts:1 ({type:string,[k:string]:unknown}); seq handled by Number() cast at web/lib/use-book-stream.ts:92-96",
      "backend": "deeptutor/api/routers/book.py:1467-1476 (_serialize_event always emits type/source/stage/content/metadata/seq/timestamp)",
      "impact": "Deliberate looseness for a generic event channel, but the seq/timestamp/source contract is invisible to type checking; a rename on the backend would not be caught by the web build.",
      "suggestion": "optional: add an optional-fields interface for the known envelope keys while keeping the index signature"
    },
    {
      "id": "F-B4",
      "entry": "E09",
